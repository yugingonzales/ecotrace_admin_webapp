node_modules/
dist/
build/
.cache/
.env*
# ...but the template is documentation and must be shared, or a fresh clone
# has no idea which VITE_* keys exist. The rule above is `.env*`, not `.env`,
# so it swallows `.env.example` too.
!.env.example
.vite/
vite.config.*.timestamp-*
*.tsbuildinfo
*-debug.log*
logs/
*.log
*.err
.claude-replay.*
.tmp-*
# Database backups/dumps taken before destructive migrations. These contain
# real user data (password hashes, emails) and must never be committed;
# only migrations/*.sql are the tracked schema.
server/*_backup*.sql
