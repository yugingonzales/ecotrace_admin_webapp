# ─────────────────────────────────────────────────────────────────────────────
# EcoTrace Admin Portal — environment template
#
# Copy to `.env.local` (git-ignored via the `.env*` rule in .gitignore):
#     cp .env.example .env.local
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER put secrets, database credentials, or JWT signing keys in this file.
# ─────────────────────────────────────────────────────────────────────────────

# Master switch for the API client in src/lib/api.js.
# While this is 'false' every module keeps rendering its current in-memory mock
# data and no network request is ever issued. Flip to 'true' only once the
# Node.js REST API is running and reachable.
VITE_ENABLE_API=false

# Base URL the API client prefixes onto every request path.
# '/api' is correct in development and in production when the app is served
# behind a reverse proxy that forwards /api to the API origin. Use an absolute
# origin (e.g. https://api.ecotrace.uep.edu.ph/api) for a split-host deployment.
VITE_API_BASE_URL=/api

# Request timeout in milliseconds before a call is aborted as a network failure.
VITE_API_TIMEOUT_MS=15000

# ── Development-only ────────────────────────────────────────────────────────
# These are read from the Node process environment (they are NOT bundled) and
# belong in your shell, not in .env.local.
#
# Vite rewrites /api -> this origin during `npm run dev` and `npm run preview`.
# VITE_API_PROXY_TARGET=http://localhost:3000
#
# Port binding. The two servers used to share one `PORT` variable, which meant
# exporting PORT=3000 for the API also made Vite try to bind 3000 and abort on
# strictPort. Each process now owns its own variable.
# VITE_PORT=8443            # UI dev/preview server
# API_PORT=3000             # REST API (server/src/index.js)
#
# Database connection for the API only (server/src/db.js). Defaults are XAMPP's
# stock root-with-no-password local MariaDB.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=ecotrace_db
